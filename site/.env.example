# Copy to .env.local and fill in what you need. Anything prefixed VITE_ is
# bundled into the client JavaScript and visible to every visitor — never put
# real secrets behind a VITE_ prefix in production.

# ── Landing page (index.html) ────────────────────────────────────────────────

# Absolute URL of the deployed San3 workspace app (e.g. https://app.example.com
# or https://example.com/app.html). When set, the landing header shows a
# "Log in" link pointing here; when unset, the link stays hidden because this
# site is a static single deploy with no /login route of its own.
VITE_APP_URL=

# HTTP endpoint that accepts the early-access form as POST JSON {name, email}.
# When unset, the form falls back to opening the visitor's mail client
# (mailto:) instead.
VITE_EARLY_ACCESS_ENDPOINT=

# ── Workspace demo (app.html) ────────────────────────────────────────────────

# Google OAuth 2.0 Client ID (Web application) with the Gmail API enabled.
# Setup steps are documented in src/app/config.ts.
VITE_GOOGLE_CLIENT_ID=

# Gemini API key for the two AI layers (extraction + reasoning).
# WARNING (from src/app/config.ts): a VITE_-prefixed key ships to every
# visitor's browser. Fine for a local demo — put the model calls behind a
# server-side proxy before any production deployment.
VITE_GEMINI_API_KEY=
