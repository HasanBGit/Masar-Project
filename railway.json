{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": ["backend/**"]
  },
  "deploy": {
    "startCommand": "cd backend && gunicorn config.wsgi --log-file -",
    "releaseCommand": "cd backend && python manage.py migrate --noinput && python manage.py collectstatic --noinput",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
