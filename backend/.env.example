DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://USER@127.0.0.1:5432/truepoint_dev
DB_CONN_MAX_AGE=60
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# --- Production only (leave unset for local dev) -----------------------------
# Set these when deploying: DEBUG=False, ALLOWED_HOSTS=your-api-host,
# DATABASE_URL=<Supabase connection string, Settings > Database > Connection
# string > URI - append ?sslmode=require if not already present>,
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app (needed for admin login).
CSRF_TRUSTED_ORIGINS=

# Optional: Supabase Storage (S3-compatible) for uploaded files
# (drawings_studio). Leave all three unset to keep using local disk storage.
# Bucket must be created first in the Supabase dashboard (Storage > New bucket).
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3

# Optional: contract_payments legal-agent chatbot (RAG). Leave both unset to
# keep the feature disabled (it fails closed with a clear 503, not silently).
# VOYAGE_API_KEY=
# ANTHROPIC_API_KEY=
