# Frontend environment - point this at the live Railway backend
# Copy this file to .env.local and run: npm install && npm run dev

VITE_API_URL=https://masar-project-production.up.railway.app/api/v1

# Google Sign-In (Google Identity Services) - same OAuth 2.0 Client ID as the
# backend's GOOGLE_OAUTH_CLIENT_ID. Leave unset to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
