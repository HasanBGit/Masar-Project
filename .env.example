# ==============================================================================
# Masar / San3 Project - Environment Configuration
# ==============================================================================

# --- Backend Configuration (backend/.env) ---
# Secret key for Django application (50+ random characters in production)
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-in-production

# Enable debug mode for local development (Set False in production)
DEBUG=True

# Allowed HTTP host headers (comma-separated list)
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database URL
# Local Dev: postgres://user@127.0.0.1:5432/truepoint_dev
# Supabase Production: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://127.0.0.1:5432/truepoint_dev

# Database connection max age in seconds
DB_CONN_MAX_AGE=60

# CORS Allowed Origins for frontend clients
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# CSRF Trusted Origins (Required in production for Admin login across domains)
CSRF_TRUSTED_ORIGINS=http://localhost:5174

# Saudi Arabia PDPL Data Residency Region Code ("sa")
DATA_RESIDENCY_REGION=sa

# --- Frontend App Configuration (frontend/.env) ---
# API Base URL for frontend production builds (Vercel)
# Local Dev uses Vite proxy (/api/v1) automatically
# Production: https://api.yourdomain.com/api/v1
VITE_API_URL=

# Local Vite Dev Proxy target port (Default: http://127.0.0.1:8000)
VITE_BACKEND_TARGET=http://127.0.0.1:8000

# --- Optional Integrations ---
# Supabase Storage S3 credentials for uploaded drawing files
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3

# --- AI / LLM Configuration ---
# OpenRouter API Key & Model (Gemini Flash)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash


# Legacy / Direct Provider Keys (Optional)
# VOYAGE_API_KEY=
# ANTHROPIC_API_KEY=

